# ============================
# CoverM per-sample cleaning
# ============================
library(tidyverse)
# ----------------------------
# 1. Define folders (FIXED)
# ----------------------------
folder <- "/Users/jasge/Documents/GitHub/dsp-smoke-metag/02-deREP/01-CoverM/count"
stopifnot(dir.exists(folder))
# Results directory (inside count/)
results_dir <- file.path(folder, "results")
dir.create(results_dir, showWarnings = FALSE, recursive = TRUE)
# ----------------------------
# 2. List CoverM files
# ----------------------------
files <- list.files(
path = folder,
pattern = "MMBO_\\d+.*\\.tsv$",
full.names = TRUE
)
stopifnot(length(files) > 0)
message("Found ", length(files), " CoverM files")
# ----------------------------
# 3. Function to clean ONE file
# ----------------------------
clean_coverm_file <- function(f) {
read_tsv(f, show_col_types = FALSE) %>%
filter(Genome != "unmapped") %>%
rename(
Read_Count               = matches("Read Count$"),
Mean                     = matches(" Mean$"),
`Relative Abundance (%)` = matches("Relative Abundance"),
`Covered Bases`          = matches("Covered Bases$"),
`Covered Fraction`       = matches("Covered Fraction$"),
RPKM                     = matches(" RPKM$"),
TPM                      = matches(" TPM$")
)
}
# ----------------------------
# 4. Process all files
# ----------------------------
for (f in files) {
sample_name <- str_extract(basename(f), "MMBO_\\d+")
message("Processing sample: ", sample_name)
clean_df <- clean_coverm_file(f)
out_file <- file.path(
results_dir,
paste0("coverm_", sample_name, "_clean.tsv")
)
write_tsv(clean_df, out_file)
message("  → Written: ", out_file)
}
# ----------------------------
# 5. Done
# ----------------------------
message("All CoverM files cleaned successfully")
# ============================
# CoverM metric-wise matrices
# (from CLEAN per-sample files)
# ============================
library(tidyverse)
# ----------------------------
# 1. Define folders (FIXED)
# ----------------------------
# Folder with CLEAN per-sample files
folder <- "/Users/jasge/Documents/GitHub/dsp-smoke-metag/02-deREP/01-CoverM/count/results"
stopifnot(dir.exists(folder))
# Final output directory (same logic as before)
results_dir <- file.path(folder, "final")
dir.create(results_dir, showWarnings = FALSE, recursive = TRUE)
# ----------------------------
# 2. List clean files
# ----------------------------
files <- list.files(
path = folder,
pattern = "coverm_MMBO_\\d+_clean\\.tsv$",
full.names = TRUE
)
stopifnot(length(files) > 0)
# ----------------------------
# 3. Metric → column mapping
# ----------------------------
metrics <- c(
"mean"               = "Mean",
"relative_abundance" = "Relative Abundance (%)",
"covered_fraction"   = "Covered Fraction",
"covered_bases"      = "Covered Bases",
"rpkm"               = "RPKM",
"tpm"                = "TPM"
)
# ----------------------------
# 4. Process metrics (EXACTLY like before)
# ----------------------------
for (metric_name in names(metrics)) {
message("Processing metric: ", metric_name)
column_name <- metrics[[metric_name]]
df_list <- lapply(files, function(f) {
sample_name <- stringr::str_extract(basename(f), "MMBO_\\d+")
df <- readr::read_tsv(f, show_col_types = FALSE)
if (!column_name %in% colnames(df)) return(NULL)
df %>%
select(
genome = Genome,
value  = all_of(column_name)
) %>%
mutate(value = as.numeric(value)) %>%
rename(!!sample_name := value)
})
df_list <- purrr::compact(df_list)
if (length(df_list) == 0) {
message("  → No valid data for metric: ", metric_name, " (skipping)")
next
}
merged_df <- purrr::reduce(df_list, full_join, by = "genome")
merged_df[is.na(merged_df)] <- 0
out_file <- file.path(
results_dir,
paste0("coverm_", metric_name, ".tsv")
)
write_tsv(merged_df, out_file)
message("  → Written: ", out_file)
}
message("All CoverM metric tables written successfully")
