# ============================
# CoverM clean → long format
# ============================
library(tidyverse)
# ----------------------------
# 1. Define folders (FIXED)
# ----------------------------
# Folder with CLEAN per-sample CoverM files
folder <- "/Users/jasge/Documents/GitHub/dsp-smoke-metag/02-deREP/01-CoverM/count/results"
stopifnot(dir.exists(folder))
# Output directory for this workflow
results_dir <- "/Users/jasge/Documents/GitHub/dsp-smoke-metag/02-deREP/02-Clustering_Genes/02-Coverage/results"
dir.create(results_dir, showWarnings = FALSE, recursive = TRUE)
# ----------------------------
# 2. List clean CoverM files
# ----------------------------
files <- list.files(
path = folder,
pattern = "coverm_MMBO_\\d+_clean\\.tsv$",
full.names = TRUE
)
stopifnot(length(files) > 0)
message("Found ", length(files), " clean CoverM files")
# ----------------------------
# 3. Read + combine + long
# ----------------------------
coverm_long <- purrr::map_dfr(files, function(f) {
sample_name <- stringr::str_extract(basename(f), "MMBO_\\d+")
readr::read_tsv(f, show_col_types = FALSE) %>%
dplyr::mutate(Sample = sample_name) %>%
tidyr::pivot_longer(
cols = -c(Genome, Sample),
names_to  = "metric",
values_to = "value"
)
})
# ----------------------------
# 4. Sanity checks
# ----------------------------
stopifnot(!any(coverm_long$Genome == "unmapped"))
dplyr::count(coverm_long, metric)
dplyr::n_distinct(coverm_long$Sample)
# ----------------------------
# 5. Write output
# ----------------------------
out_file <- file.path(results_dir, "coverm_long.tsv")
readr::write_tsv(coverm_long, out_file)
message("Written: ", out_file)
